/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build outputs ──
/.next/
/out/
/build

# ── Testing ──
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# ── Storybook ──
*storybook.log
storybook-static

# ── Environment ──
.env*

# ── Editor ──
*.swp
*.swo
*~
Session.vim
.netrwhist
.idea/
*.sublime-workspace
*.sublime-project
.cursor/
*.kate-swp
.vscode/*

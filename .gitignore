!.vscode/launch.json
!.vscode/settings.json

# ── OS ──
.DS_Store
Thumbs.db

# ── Backups ──
*.bak
*.orig

# ── Linting & Formatting ──
.eslintcache
.stylelintcache

# ── Debug ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*

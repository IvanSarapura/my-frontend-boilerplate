# Fail installs whose Node/npm versions fall outside the major-locked ranges in
# package.json engines. Exact recommended versions: .nvmrc + packageManager.
engine-strict=true

# Treat peer dependency conflicts as fatal errors instead of warnings.
# npm 7+ automatically attempts to resolve peer conflicts, which can silently
# install incompatible versions. strict-peer-deps=true forces CI and local
# installs to fail immediately, protecting the dependency tree integrity.
# This prevents scenarios like eslint-plugin-import incompatible with eslint 10
# from ever reaching the lockfile.
strict-peer-deps=true
